{
  "name": "revya",
  "version": "0.1.0",
  "description": "Transforma celulares Samsung em dispositivos de mídia para TV via ADB",
  "main": "src/main/main.js",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && electron . --dev",
    "dev": "concurrently -k -n VITE,ELECTRON -c cyan,yellow \"npm:dev:vite\" \"npm:dev:electron\"",
    "check:i18n": "node scripts/check-i18n.js",
    "build:renderer": "node scripts/check-i18n.js && vite build",
    "start": "npm run build:renderer && electron .",
    "dist": "npm run build:renderer && electron-builder",
    "dist:win": "npm run build:renderer && electron-builder --win --config.directories.output=/private/tmp/revya-build && npm run verify:win",
    "dist:mac": "npm run build:renderer && electron-builder --mac",
    "dist:linux": "npm run build:renderer && electron-builder --linux",
    "verify:win": "node scripts/verify-win.js"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@mui/material": "^5.15.20",
    "@mui/icons-material": "^5.15.20",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.3.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.revya.tv",
    "productName": "Revya",
    "publish": null,
    "directories": {
      "output": "release"
    },
    "files": [
      "src/main/**/*",
      "src/adb/**/*",
      "src/i18n/**/*",
      "dist/renderer/**/*"
    ],
    "extraResources": [
      {
        "from": "platform-tools/${os}",
        "to": "platform-tools",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "scrcpy/${os}",
        "to": "scrcpy",
        "filter": [
          "**/*",
          "!README.txt",
          "!adb",
          "!adb.exe",
          "!*.1"
        ]
      },
      {
        "from": "apks",
        "to": "apks",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "${productName}-${version}-${arch}-portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "O Revya usa a rede local para conectar ao seu celular por Wi-Fi (modo sem fio e espelhamento sem cabo)."
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "Revya"
    },
    "afterPack": "scripts/after-pack.js"
  }
}
